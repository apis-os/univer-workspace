{
  "name": "@univerjs/univer-workspace-client-core",
  "version": "0.0.0",
  "private": true,
  "description": "Private Univer Workspace client workflows for Node-hosted agent clients.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./worker": {
      "types": "./src/content-worker.ts",
      "development": "./src/content-worker.ts",
      "default": "./dist/content-worker.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p render-runtime/tsconfig.json --noEmit && vite build --config render-runtime/vite.config.ts",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@univer-cli/content-execution": "file:../../vendor/univer-cli/content-execution",
    "@univer-cli/doc-typst-facade": "file:../../vendor/univer-cli/doc-typst-facade",
    "@univer-cli/headless-univer": "file:../../vendor/univer-cli/headless-univer",
    "@univer-cli/svg-facade": "file:../../vendor/univer-cli/svg-facade",
    "@univer-cli/unit-layout-lint": "file:../../vendor/univer-cli/unit-layout-lint",
    "@univer-cli/unit-pdf-printer": "file:../../vendor/univer-cli/unit-pdf-printer",
    "@univer-cli/unit-screenshot": "file:../../vendor/univer-cli/unit-screenshot",
    "@univer-cli/univer-collaboration-runtime": "file:../../vendor/univer-cli/univer-collaboration-runtime",
    "@univer-cli/univer-collaboration-runtime-pool": "file:../../vendor/univer-cli/univer-collaboration-runtime-pool",
    "@univer-cli/univer-render-page": "file:../../vendor/univer-cli/univer-render-page",
    "@univer-cli/univer-render-runtime": "file:../../vendor/univer-cli/univer-render-runtime",
    "@univerjs-pro/collaboration": "file:../../vendor/univer-pro/collaboration",
    "@univerjs-pro/embed": "file:../../vendor/univer-pro/embed",
    "@univerjs-pro/exchange-node": "file:../../vendor/univer-pro/exchange-node",
    "@univerjs/core": "file:../../vendor/univer/core",
    "@univerjs/protocol": "file:../../vendor/univer/protocol"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.10"
  }
}
