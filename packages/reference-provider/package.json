{
  "name": "@univerjs/univer-workspace-reference-provider",
  "version": "0.0.0",
  "private": true,
  "description": "Private Univer Workspace policy for lazily materializing referenced Units.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.test.json --noEmit"
  },
  "peerDependencies": {
    "@univerjs-pro/collaboration": "file:../../vendor/univer-pro/collaboration",
    "@univerjs-pro/embed": "file:../../vendor/univer-pro/embed",
    "@univerjs/core": "file:../../vendor/univer/core"
  },
  "devDependencies": {
    "@univerjs-pro/collaboration": "file:../../vendor/univer-pro/collaboration",
    "@univerjs-pro/embed": "file:../../vendor/univer-pro/embed",
    "@univerjs/core": "file:../../vendor/univer/core",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
