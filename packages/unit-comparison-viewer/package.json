{
  "name": "@univer/unit-comparison-viewer",
  "version": "0.1.0",
  "private": true,
  "description": "Copyable React viewer for read-only Univer unit comparisons.",
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles.css": "./styles.css"
  },
  "scripts": {
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json --noEmit --pretty false"
  },
  "dependencies": {
    "@univerjs-pro/bases": "file:../../vendor/univer-pro/bases",
    "@univerjs-pro/boards": "file:../../vendor/univer-pro/boards",
    "@univerjs-pro/boards-ui": "file:../../vendor/univer-pro/boards-ui",
    "@univerjs-pro/edit-history-ui": "file:../../vendor/univer-pro/edit-history-ui",
    "@univerjs-pro/slides": "file:../../vendor/univer-pro/slides",
    "@univerjs-pro/slides-ui": "file:../../vendor/univer-pro/slides-ui",
    "@univerjs/core": "file:../../vendor/univer/core",
    "@univerjs/docs-ui": "file:../../vendor/univer/docs-ui",
    "@univerjs/drawing": "file:../../vendor/univer/drawing",
    "@univerjs/engine-formula": "file:../../vendor/univer/engine-formula",
    "@univerjs/engine-render": "file:../../vendor/univer/engine-render",
    "@univerjs/sheets": "file:../../vendor/univer/sheets",
    "@univerjs/sheets-conditional-formatting": "file:../../vendor/univer/sheets-conditional-formatting",
    "@univerjs/sheets-filter": "file:../../vendor/univer/sheets-filter",
    "@univerjs/sheets-formula": "file:../../vendor/univer/sheets-formula",
    "@univerjs/sheets-numfmt": "file:../../vendor/univer/sheets-numfmt",
    "@univerjs/sheets-table": "file:../../vendor/univer/sheets-table",
    "@univerjs/sheets-ui": "file:../../vendor/univer/sheets-ui",
    "@univerjs/ui": "file:../../vendor/univer/ui",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@univerjs-pro/docs-history": "file:../../vendor/univer-pro/docs-history",
    "@univerjs-pro/sheets-history": "file:../../vendor/univer-pro/sheets-history",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20",
    "tailwindcss": ">=4"
  }
