    "@univerjs/protocol": "1.0.0-insiders.20260907-70fc579",
    "@univerjs/ui": "1.0.0-insiders.20260907-70fc579"
  },
  "devDependencies": {
    "postcss": "^8.5.26",
    "react": "18.3.1",
    "rxjs": "7.8.2",
    "tailwindcss": "3.4.17",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "@univerjs-infra/shared": "1.0.0-beta.2"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "build:bundle": "univer-cli build",
    "build:types": "tsc -p tsconfig.node.json",
    "build": "pnpm run build:bundle && pnpm run build:types"
  },
