{
  "name": "@univerjs-pro/collaboration-client",
  "version": "1.0.0-insiders.20260907-70fc579",
  "private": false,
  "description": "Client-side collaboration plugin for Univer Pro.",
  "author": "DreamNum Co., Ltd. <developer@univer.ai>",
  "funding": {
    "type": "opencollective",
    "url": "https://opencollective.com/univer"
  },
  "homepage": "https://univer.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/dream-num/univer-pro"
  },
  "bugs": {
    "url": "https://github.com/dream-num/univer/issues"
  },
  "keywords": [
    "univer",
    "univer-pro",
    "collaboration",
    "client",
    "plugin"
  ],
  "exports": {
    ".": {
      "import": "./lib/es/index.js",
      "require": "./lib/cjs/index.js",
      "types": "./lib/types/index.d.ts"
    },
    "./*": {
      "import": "./lib/es/*",
      "require": "./lib/cjs/*",
      "types": "./lib/types/index.d.ts"
    },
    "./locale/*": {
      "import": "./lib/es/locale/*.js",
      "require": "./lib/cjs/locale/*.js",
      "types": "./lib/types/locale/*.d.ts"
    },
    "./facade": {
      "import": "./lib/es/facade.js",
      "require": "./lib/cjs/facade.js",
      "types": "./lib/types/facade/index.d.ts"
    },
    "./lib/facade": {
      "import": "./lib/es/facade.js",
      "require": "./lib/cjs/facade.js",
      "types": "./lib/types/facade/index.d.ts"
    },
    "./lib/*": "./lib/*"
  },
  "main": "./lib/es/index.js",
  "types": "./lib/types/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "directories": {
    "lib": "lib"
  },
  "files": [
    "lib"
  ],
  "peerDependencies": {
    "rxjs": ">=7.0.0"
  },
  "dependencies": {
    "@noble/ciphers": "^2.2.0",
    "@univerjs-pro/collaboration": "1.0.0-insiders.20260907-70fc579",
    "@univerjs-pro/slides": "1.0.0-insiders.20260907-70fc579",
    "@univerjs-pro/license": "1.0.0-insiders.20260907-70fc579",
    "@univerjs/docs": "1.0.0-insiders.20260907-70fc579",
    "@univerjs/drawing": "1.0.0-insiders.20260907-70fc579",
    "@univerjs/network": "1.0.0-insiders.20260907-70fc579",
    "@univerjs/sheets": "1.0.0-insiders.20260907-70fc579",
    "@univerjs/protocol": "1.0.0-insiders.20260907-70fc579",
    "@univerjs/core": "1.0.0-insiders.20260907-70fc579",
    "@univerjs/telemetry": "1.0.0-insiders.20260907-70fc579"
  },
  "devDependencies": {
    "rxjs": "7.8.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "@univerjs-infra/shared": "1.0.0-beta.2",
    "@univerjs-pro/bases": "1.0.0-insiders.20260907-70fc579",
    "@univerjs-pro/boards": "1.0.0-insiders.20260907-70fc579",
    "@univerjs-pro/pdfs": "1.0.0-insiders.20260907-70fc579"
  },
  "scripts": {
    "test": "vitest run --pool=threads",
    "test:watch": "vitest --pool=threads",
    "coverage": "vitest run --coverage --pool=threads",
    "typecheck": "tsc --noEmit",
    "build:bundle": "univer-cli build",
    "build:types": "tsc -p tsconfig.node.json",
    "build": "pnpm run build:bundle && pnpm run build:types"
  },
  "module": "./lib/es/index.js"
}