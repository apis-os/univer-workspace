      "require": "./lib/cjs/locale/*.js",
      "types": "./lib/types/locale/*.d.ts"
    },
    "./lib/*": "./lib/*"
  },
  "main": "./lib/es/index.js",
  "types": "./lib/types/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "lib"
  ],
  "peerDependencies": {
    "react": "^16.9.0 || ^17.0.0 || ^18.0.0 || ^19.0.0 || ^19.0.0-rc",
    "rxjs": ">=7.0.0"
  },
  "dependencies": {
    "@univerjs/icons": "1.35.0",
    "@univerjs-pro/license": "1.0.0-insiders.20260907-70fc579",
    "@univerjs-pro/slides-thread-comment": "1.0.0-insiders.20260907-70fc579",
    "@univerjs-pro/slides-ui": "1.0.0-insiders.20260907-70fc579",
    "@univerjs-pro/slides": "1.0.0-insiders.20260907-70fc579",
    "@univerjs/core": "1.0.0-insiders.20260907-70fc579",
