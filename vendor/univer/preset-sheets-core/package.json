{
  "name": "@univerjs/preset-sheets-core",
  "version": "1.0.0-insiders.20260907-70fc579",
  "private": false,
  "description": "Preset for core Univer Sheets spreadsheet features.",
  "author": "DreamNum Co., Ltd. <developer@univer.ai>",
  "license": "Apache-2.0",
  "funding": {
    "type": "opencollective",
    "url": "https://opencollective.com/univer"
  },
  "homepage": "https://univer.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/dream-num/univer"
  },
  "bugs": {
    "url": "https://github.com/dream-num/univer/issues"
  },
  "keywords": [
    "univer",
    "univer-preset",
    "sheets",
    "core"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "import": "./lib/es/index.js",
      "require": "./lib/cjs/index.js",
      "types": "./lib/types/index.d.ts"
    },
    "./worker": {
      "import": "./lib/es/worker.js",
      "require": "./lib/cjs/worker.js",
      "types": "./lib/types/worker.d.ts"
    },
    "./locales/*": {
      "import": "./lib/es/locales/*.js",
      "require": "./lib/cjs/locales/*.js",
      "types": "./lib/types/locales/*.d.ts"
    },
    "./lib/*": "./lib/*"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./lib/es/index.js",
  "directories": {
    "lib": "lib"
  },
  "types": "./lib/types/index.d.ts",
  "files": [
    "lib"
  ],
  "peerDependencies": {
    "react": "^16.9.0 || ^17.0.0 || ^18.0.0 || ^19.0.0 || ^19.0.0-rc",
    "react-dom": "^16.9.0 || ^17.0.0 || ^18.0.0 || ^19.0.0 || ^19.0.0-rc",
    "rxjs": ">=7.0.0"
  },
  "dependencies": {
    "@univerjs/design": "1.0.0-insiders.20260907-70fc579",
    "@univerjs/docs-ui": "1.0.0-insiders.20260907-70fc579",
    "@univerjs/docs": "1.0.0-insiders.20260907-70fc579",
    "@univerjs/engine-render": "1.0.0-insiders.20260907-70fc579",
    "@univerjs/engine-formula": "1.0.0-insiders.20260907-70fc579",
    "@univerjs/network": "1.0.0-insiders.20260907-70fc579",
    "@univerjs/rpc": "1.0.0-insiders.20260907-70fc579",
    "@univerjs/sheets": "1.0.0-insiders.20260907-70fc579",
    "@univerjs/sheets-formula": "1.0.0-insiders.20260907-70fc579",
    "@univerjs/sheets-formula-ui": "1.0.0-insiders.20260907-70fc579",
    "@univerjs/sheets-numfmt": "1.0.0-insiders.20260907-70fc579",
    "@univerjs/sheets-numfmt-ui": "1.0.0-insiders.20260907-70fc579",
    "@univerjs/sheets-ui": "1.0.0-insiders.20260907-70fc579",
    "@univerjs/ui": "1.0.0-insiders.20260907-70fc579"
  },
  "devDependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "rxjs": "^7.8.2",
    "typescript": "^6.0.3",
    "@univerjs-infra/shared": "1.0.0-beta.2",
    "@univerjs/core": "1.0.0-insiders.20260907-70fc579",
    "@univerjs/presets": "1.0.0-insiders.20260907-70fc579"
  },
  "scripts": {
    "build:bundle": "univer-cli preset build --cleanup",
    "build:types": "tsc -p tsconfig.node.json",
    "build": "pnpm run build:bundle && pnpm run build:types",
    "typecheck": "tsc --noEmit"
  },
  "module": "./lib/es/index.js"
}