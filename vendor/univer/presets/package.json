{
  "name": "@univerjs/presets",
  "version": "1.0.0-insiders.20260907-70fc579",
  "private": false,
  "description": "Build Univer apps faster and easier with pre-configured plugin collections.",
  "author": "DreamNum Co., Ltd. <developer@univer.ai>",
  "license": "Apache-2.0",
  "funding": {
    "type": "opencollective",
